# PaperBroker uses public live market data and does not need keys.
# Keys are only required for Binance Demo Trading / Testnet / live signed endpoints.

# live | demo | testnet
BINANCE_ENV=demo

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Jev / TypeSafe. Required for scripts/jev_sol_backtest.py
TYPESAFE_API_KEY=

# Optional. Defaults are listed in jev_trading.binance.endpoints
# BINANCE_REST_BASE=
# BINANCE_WS_STREAM_BASE=
